# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=                  # Neon connection string

# Better Auth / JWT
BETTER_AUTH_SECRET=            # long random secret for signing tokens
BETTER_AUTH_URL=               # base URL of this API e.g. http://localhost:3000
JWT_ACCESS_EXPIRES_IN=15m      # access token lifetime
JWT_REFRESH_EXPIRES_IN=7d      # refresh token lifetime

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry
SENTRY_DSN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                 # public base URL for serving uploaded files

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# CORS
ALLOWED_ORIGINS=               # comma-separated list of allowed frontend origins

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_MAX=100

# Auth rate limiting (stricter on auth routes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
