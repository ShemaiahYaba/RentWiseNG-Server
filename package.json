{
  "name": "rentwise-server",
  "version": "0.1.0",
  "description": "RentWise API — Team Neon, TechCrush Buildathon 2026",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "deps:pin": "tsx scripts/deps-pin.ts",
    "deps:check": "tsx scripts/deps-check.ts",
    "version:bump": "tsx scripts/version-bump.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@neondatabase/serverless": "0.10.2",
    "@sentry/node": "9.47.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.39.3",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "google-auth-library": "9.15.1",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "resend": "6.12.3",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@inquirer/prompts": "7.10.1",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.19",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.30.6",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "semver": "7.8.1",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4",
    "yaml": "2.9.0"
  }
}
